{
  "name": "wedding-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/v1",
    "apps/v2",
    "apps/v3"
  ],
  "scripts": {
    "dev:v1": "npm --workspace apps/v1 run dev",
    "dev:v2": "npm --workspace apps/v2 run dev",
    "dev:v3": "npm --workspace apps/v3 run dev",
    "build:v1": "npm --workspace apps/v1 run build",
    "build:v2": "npm --workspace apps/v2 run build",
    "build:v3": "npm --workspace apps/v3 run build",
    "build:all": "npm run build:v1 && npm run build:v2 && npm run build:v3",
    "lint": "npm exec tsc -- --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
