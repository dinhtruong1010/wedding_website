{
  "name": "wedding-website",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://dinhtruong1010.github.io/wedding_website/",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:v2": "vite --config vite.v2.config.ts",
    "dev:v3": "vite --config vite.v3.config.ts",
    "build": "vite build",
    "build:v2": "vite --config vite.v2.config.ts build",
    "build:v3": "vite --config vite.v3.config.ts build",
    "build:v3:standalone": "VITE_BASE_PATH=/ vite --config vite.v3.config.ts build",
    "build:all": "npm run build && npm run build:v2 && npm run build:v3",
    "preview": "vite preview",
    "preview:v2": "vite preview --outDir dist-v2 --port 4174",
    "preview:v3": "vite preview --outDir dist-v3 --port 4175",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.475.0",
    "motion": "^12.4.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0"
  }
}
