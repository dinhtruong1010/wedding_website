{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "installCommand": "npm install",
  "rewrites": [
    { "source": "/na", "destination": "/na.html" },
    { "source": "/na/(.*)", "destination": "/na.html" }
  ],
  "images": {
    "sizes": [480, 960, 1600],
    "qualities": [75],
    "formats": ["image/avif", "image/webp"],
    "minimumCacheTTL": 2678400,
    "localPatterns": [{ "pathname": "^/data/.*$", "search": "" }],
    "remotePatterns": [{ "protocol": "https", "hostname": "ysbdrn9l73bqap2q.public.blob.vercel-storage.com", "pathname": "^/wedding/.*$" }]
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(data|audio)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }]
    },
    {
      "source": "/(og-image.jpg|favicon.svg|favicon-32.png|apple-touch-icon.png)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }]
    }
  ]
}
